#!/usr/bin/env bash
# Test stub for the gh CLI, used by the bats suites.
#
# Every invocation is appended (shell-quoted, one line) to $GH_STUB_LOG so
# tests can assert exactly which calls were made — in particular that
# --dry-run never issues a non-GET request.
#
# `gh api` responses are served from fixture files in $GH_STUB_DIR, keyed by
# "<METHOD>_<path with non-alphanumerics mapped to _>":
#   <key>       body printed to stdout, exit 0 (empty file = bodiless success)
#   <key>.err   contents printed to stderr, exit 1
#   <key>.exit  with <key>, exit with this code after printing the body, as
#               gh does for a GraphQL response that carries errors
#   neither     "HTTP 404"-style error to stderr, exit 1 (matches how the
#               bootstrap script distinguishes absent resources)
#
# `gh api graphql` responses are keyed "graphql_<OperationName>", taken from
# the document passed as -f query=. Every operation the scripts send is named
# for exactly this reason; an anonymous document is a stub error, not a silent
# miss. When "<key>.1" exists the fixtures are served in sequence (.1, .2, ...),
# which is how a paginated --slurp run and per-page error injection are
# expressed.
#
# With -i, the response is prefixed with a status line and
# X-Ratelimit-Remaining (from $GH_STUB_RATELIMIT, default 4999) so the rate
# brake can be exercised. A "<key>.headers" file overrides that block.
#
# `gh pr <sub>` responses use the same scheme keyed "pr_<sub>". Without a
# fixture, the mutating subcommands (edit/comment/merge) succeed bodiless —
# most tests only assert on the log — but `pr list` fails: its callers feed
# the body to jq, so a silent empty response would green-light a test that
# never exercised the filter.
set -euo pipefail

: "${GH_STUB_DIR:?gh stub requires GH_STUB_DIR}"
: "${GH_STUB_LOG:?gh stub requires GH_STUB_LOG}"

printf '%q ' gh "$@" >>"$GH_STUB_LOG"
printf '\n' >>"$GH_STUB_LOG"

case ${1:-} in
    auth)
        exit 0
        ;;
    api) ;;
    pr)
        key="pr_${2:-}"
        if [[ -f $GH_STUB_DIR/$key.err ]]; then
            cat "$GH_STUB_DIR/$key.err" >&2
            exit 1
        fi
        if [[ -f $GH_STUB_DIR/$key ]]; then
            cat "$GH_STUB_DIR/$key"
            exit 0
        fi
        case ${2:-} in
            edit | comment | merge)
                exit 0
                ;;
            *)
                printf 'gh-stub: no fixture %s for gh pr %s\n' "$key" "${2:-}" >&2
                exit 1
                ;;
        esac
        ;;
    *)
        printf 'gh-stub: unexpected command: %s\n' "$*" >&2
        exit 64
        ;;
esac
shift

method=GET
path=""
jq_filter=""
gql_doc=""
include_headers=false
while [[ $# -gt 0 ]]; do
    case $1 in
        -X)
            method=$2
            shift 2
            ;;
        --jq | -q)
            jq_filter=$2
            shift 2
            ;;
        --input)
            shift 2
            ;;
        -f | -F)
            # Typed/raw fields. Only the GraphQL document changes what we
            # serve; the variables are already in the log for assertions.
            case $2 in
                query=*) gql_doc=${2#query=} ;;
            esac
            shift 2
            ;;
        -i | --include)
            include_headers=true
            shift
            ;;
        --paginate | --slurp | -*)
            shift
            ;;
        *)
            path=$1
            shift
            ;;
    esac
done

if [[ $path == graphql ]]; then
    op=$(printf '%s' "$gql_doc" | sed -n 's/^[[:space:]]*query \([A-Za-z_][A-Za-z0-9_]*\).*/\1/p' | head -1)
    if [[ -z $op ]]; then
        printf 'gh-stub: anonymous graphql document — name every operation\n' >&2
        exit 64
    fi
    key="graphql_$op"
else
    key="${method}_$(printf '%s' "$path" | tr -c 'A-Za-z0-9' '_')"
fi

# Sequenced fixtures: serve <key>.1, <key>.2, ... in order when they exist.
if [[ -f $GH_STUB_DIR/$key.1 ]]; then
    seq_file="$GH_STUB_DIR/.seq_$key"
    n=$(cat "$seq_file" 2>/dev/null || echo 0)
    n=$((n + 1))
    printf '%s' "$n" >"$seq_file"
    [[ -f $GH_STUB_DIR/$key.$n ]] && key="$key.$n"
fi

emit_headers() {
    [[ $include_headers == true ]] || return 0
    if [[ -f $GH_STUB_DIR/$key.headers ]]; then
        cat "$GH_STUB_DIR/$key.headers"
    else
        printf 'HTTP/2.0 200 OK\n'
        printf 'X-Ratelimit-Remaining: %s\n' "${GH_STUB_RATELIMIT:-4999}"
    fi
    printf '\n'
}

if [[ -f $GH_STUB_DIR/$key ]]; then
    emit_headers
    if [[ -n $jq_filter ]]; then
        jq -r "$jq_filter" <"$GH_STUB_DIR/$key"
    else
        cat "$GH_STUB_DIR/$key"
    fi
    if [[ -f $GH_STUB_DIR/$key.exit ]]; then
        printf 'gh: GraphQL: partial errors\n' >&2
        exit "$(cat "$GH_STUB_DIR/$key.exit")"
    fi
elif [[ -f $GH_STUB_DIR/$key.err ]]; then
    cat "$GH_STUB_DIR/$key.err" >&2
    exit 1
else
    printf 'gh-stub: HTTP 404: no fixture %s for %s %s\n' "$key" "$method" "$path" >&2
    exit 1
fi
