{
    "name": "automattic/dependabot-directories",
    "description": "Detect where dependency manifests and lockfiles live in a repository and map them into .github/dependabot.yml",
    "type": "project",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": "^8.2",
        "ext-json": "*",
        "ext-mbstring": "*",
        "symfony/console": "^7.4",
        "symfony/process": "^7.4",
        "symfony/yaml": "^7.4"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.64",
        "humbug/box": "^4.6",
        "pestphp/pest": "^3.5",
        "phpstan/phpstan": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "Automattic\\DependabotDirectories\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Automattic\\DependabotDirectories\\Tests\\": "tests/"
        }
    },
    "bin": [
        "bin/dependabot-directories"
    ],
    "config": {
        "platform": {
            "php": "8.2.0"
        },
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "scripts": {
        "lint": "php-cs-fixer fix --dry-run --diff",
        "fix": "php-cs-fixer fix",
        "stan": "phpstan analyse",
        "test": "pest",
        "check": [
            "@lint",
            "@stan",
            "@test"
        ]
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
